# ==============================================================================
# Apache Configuration for Single Page Application (SPA)
# ==============================================================================

# 1. Directory Index
<IfModule mod_dir.c>
    DirectoryIndex index.html
</IfModule>

# 2. Disable Directory Browsing & MultiViews (prevents collision with routes like /media)
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# 3. SPA Routing with mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header to environment if needed
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Prevent loop for direct index.html requests
    RewriteRule ^index\.html$ - [L]

    # Do not rewrite if the file or directory exists on the server
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other requests to index.html for client-side routing
    RewriteRule ^ index.html [L]
</IfModule>

# 4. Fallback Resource (Apache 2.4+ alternative/backup to mod_rewrite)
<IfModule mod_dir.c>
    <IfModule !mod_rewrite.c>
        FallbackResource /index.html
    </IfModule>
</IfModule>

# 5. Security & Access Control
# Block access to hidden files and directories (dotfiles), except .htaccess itself
<IfModule mod_authz_core.c>
    <FilesMatch "^\.(?!htaccess)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.(?!htaccess)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Block access to sensitive source or backup files if present
<FilesMatch "\.(bak|config|env|sql|fla|psd|ini|log|sh|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Correct MIME Types & Character Encoding
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    # JavaScript
    AddType application/javascript              js mjs
    AddType application/json                    json map

    # CSS
    AddType text/css                            css

    # Fonts
    AddType font/woff                           woff
    AddType font/woff2                          woff2
    AddType font/ttf                            ttf
    AddType font/otf                            otf
    AddType application/vnd.ms-fontobject        eot

    # Images
    AddType image/svg+xml                       svg svgz
    AddType image/webp                          webp
    AddType image/png                           png
    AddType image/jpeg                          jpg jpeg
    AddType image/gif                           gif
    AddType image/x-icon                        ico

    # Character sets
    AddCharset UTF-8 .html .css .js .json .xml
</IfModule>

# 7. Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/eot
</IfModule>

# 8. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On

    # Default expiration
    ExpiresDefault "access plus 1 month"

    # HTML files: never cache to allow instant updates
    ExpiresByType text/html "access plus 0 seconds"

    # JSON files
    ExpiresByType application/json "access plus 0 seconds"

    # Static assets (JS, CSS) - cache long-term
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Media / Images - cache long-term
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # Hashed static assets can be aggressively cached (1 year)
    <FilesMatch "\.(css|js|woff2?|ttf|eot|webp|png|jpe?g|gif|ico|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Config script and HTML should never be cached (overrides general .js cache above)
    <FilesMatch "config\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Always revalidate index.html so users always get the latest build
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
